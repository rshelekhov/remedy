# Test Environment Configuration for Remedy

NODE_ENV="test"
PORT="3001"

# Database (pointing to test PostgreSQL container)
DATABASE_URL="postgresql://remedy_test:remedy_test@localhost:5434/remedy_test"

# SSO Configuration (pointing to Dockerized SSO service)
SSO_CLIENT_ID="test-client-id"
SSO_API_URL="http://localhost:8081"
SSO_EMAIL_VERIFICATION_URL="http://localhost:3001/verify-email"
SSO_PASSWORD_RESET_URL="http://localhost:3001/reset-password"

# S3/MinIO Configuration (pointing to test MinIO container)
S3_ENDPOINT="http://localhost:9001"
S3_BUCKET="remedy"
S3_ACCESS_KEY="minio_user"
S3_SECRET_KEY="minio_password"

# Test-specific settings
TEST_LOG_LEVEL="error"
TEST_TIMEOUT="30000"
