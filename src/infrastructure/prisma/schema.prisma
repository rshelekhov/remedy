// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id     // Generated by SSO, not by our app
  email String @unique
  name  String?

  // Relations
  ownedFamily       Family?         // One family per user (MVP)
  familyMemberships FamilyMember[]  // User can be a member of their own or other families

  // Note: createdAt/updatedAt managed by SSO service, not stored locally
}

model Family {
  id      String @id @default(uuid())
  name    String
  ownerId String @unique  // One family per user (MVP)
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members FamilyMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model FamilyMember {
  id       String  @id @default(uuid())
  familyId String
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // Optional - only if member has a user account
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  dateOfBirth  DateTime?
  gender       String?  // Flexible: "male", "female", etc.
  relationship String?  // Flexible: "spouse", "child", "parent", etc.

  visits       Visit[]
  medications  Medication[]
  allergies    Allergy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, userId])
  @@index([familyId])
}

model Visit {
  id             String       @id @default(uuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  visitDate      DateTime
  chiefComplaint String
  diagnosis      String?
  treatment      String?
  doctorName     String?
  clinicName     String?
  notes          String?

  files       File[]
  medications Medication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyMemberId, visitDate])
}

model File {
  id       String @id @default(uuid())
  visitId  String
  visit    Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  s3Key      String   // S3 object key
  fileName   String   // Original filename
  fileType   String   // MIME type
  fileSize   Int      // bytes
  category   String?  // Flexible: "Lab Result", "Prescription", "Imaging", "Consultation Notes", etc.
  uploadedAt DateTime @default(now())

  @@index([visitId])
}

model Medication {
  id             String       @id @default(uuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  // Optional - only if medication was prescribed during a tracked visit
  visitId String?
  visit   Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

  name              String
  dosage            String?
  frequency         String?
  startDate         DateTime?
  endDate           DateTime?
  prescribingDoctor String?
  notes             String?
  isActive          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyMemberId, isActive])
  @@index([visitId])
}

model Allergy {
  id             String       @id @default(uuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  allergen    String            // "Penicillin", "Peanuts", etc.
  severity    AllergySeverity?
  reaction    String?           // "Hives", "Anaphylaxis", etc.
  diagnosedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyMemberId])
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}
